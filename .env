NODE_ENV=development
PORT=4000

# PostgreSQL Configuration
DATABASE_URL=postgresql://techxetra:techxetra_password@localhost:5432/techxetra_db
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# Google OAuth (Optional for v1 / placeholder)
GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com

# Client Application
FRONTEND_ORIGIN=http://localhost:3000

# Security & Secrets
TICKET_HMAC_SECRET=techxetra_secure_hmac_secret_at_least_32_characters_long
SESSION_SECRET=techxetra_session_secret_for_cookies_or_csrf_32_chars

# UPI Payment Information
UPI_VPA=techxetra@upi
UPI_PAYEE_NAME=TechXetra Festival

# Lifecycles & Timeouts (in ms)
PURCHASE_RESERVATION_TTL_MS=900000
PARTICIPANT_SESSION_TTL_MS=2592000000
STAFF_SESSION_TTL_MS=43200000
COOKIE_SAMESITE=lax

SUPER_ADMIN_PASSWORD=admin@password
